# Copy to .env.local and fill in from Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_...) or the legacy "anon" key — both work.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) or the legacy "service_role" key. SERVER ONLY — never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Must match the school slug in supabase/seed.sql
NEXT_PUBLIC_SCHOOL_SLUG=school
# Monitor (class) accounts get a login address on this domain. No email is ever sent to it.
MONITOR_EMAIL_DOMAIN=nexayra.com

# --- AI (photo checks, Ask EcoPoints, weekly challenges). SERVER ONLY. ---
# gemini (default) | anthropic | mock (fixed answers, local testing only)
AI_PROVIDER=gemini
# From Google AI Studio → Get API key. Use a paid-tier key for real school photos (free-tier content may be used by Google).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Tried once if the main model fails (e.g. a usage limit). Each model has its own limits.
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
# Only if AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Eco challenge QR posters ---
# The address printed into every QR code, e.g. https://ecopoints.vercel.app (no slash at the end).
# Leave empty to use whatever address the print page was opened on.
NEXT_PUBLIC_SITE_URL=
